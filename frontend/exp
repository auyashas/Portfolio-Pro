import React, { useState} from "react";
import axios from "axios";
import { useParams, useNavigate } from "react-router-dom";

const FreelancerApplication = () => {
  const { id } = useParams();
  const navigate = useNavigate();

  const [title, setTitle] = useState("");
  const [bio, setBio] = useState("");
  const [skills, setSkills] = useState("");
  const [socialLinks, setSocialLinks] = useState("");
  const [resume, setResume] = useState(null);

  const handleSubmit = async (e) => {
    e.preventDefault();

    if (!title || !bio || !skills || !resume) {
      alert("Please fill all required fields and upload your resume.");
      return;
    }

    const formData = new FormData();
    formData.append("user_id", id);
    formData.append("title", title);
    formData.append("bio", bio);
    formData.append("skills", skills);
    formData.append("social_links", socialLinks);
    formData.append("resume", resume);

    try {
      await axios.post("http://localhost:3000/freelancer/submit", formData, {
        headers: {
          "Content-Type": "multipart/form-data",
        },
      });
      alert("Application submitted for approval.");
      navigate(`/freelancer/${id}`);
    } catch (err) {
      console.error("Submission failed:", err);
      alert("Failed to submit application. Try again.");
    }
  };

  return (
    <div className="max-w-md mx-auto mt-10 bg-white shadow-lg rounded-xl p-6">
      <h2 className="text-2xl font-bold mb-6 text-center text-blue-600">
        Freelancer Application
      </h2>
      <form onSubmit={handleSubmit} className="space-y-4">
        <input
          type="text"
          placeholder="Your Title (e.g. Web Developer)"
          value={title}
          onChange={(e) => setTitle(e.target.value)}
          className="w-full border border-gray-300 rounded p-2"
          required
        />
        <textarea
          placeholder="Brief Bio"
          value={bio}
          onChange={(e) => setBio(e.target.value)}
          className="w-full border border-gray-300 rounded p-2"
          rows={4}
          required
        />
        <input
          type="text"
          placeholder="Skills (comma-separated)"
          value={skills}
          onChange={(e) => setSkills(e.target.value)}
          className="w-full border border-gray-300 rounded p-2"
          required
        />
        <input
          type="text"
          placeholder="Social Links (optional)"
          value={socialLinks}
          onChange={(e) => setSocialLinks(e.target.value)}
          className="w-full border border-gray-300 rounded p-2"
        />
        <input
          type="file"
          accept=".pdf,.doc,.docx"
          onChange={(e) => setResume(e.target.files[0])}
          className="w-full border border-gray-300 rounded p-2"
          required
        />
        <button
          type="submit"
          className="w-full bg-blue-600 text-white py-2 rounded hover:bg-blue-700"
        >
          Submit Application
        </button>
      </form>
    </div>
  );
};

export default FreelancerApplication;
